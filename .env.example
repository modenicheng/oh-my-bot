# Copy to .env beside the omb executable (or in the process cwd).
# Never commit the real value. Process environment variables override this file.
DEEPSEEK_API_KEY=

# ---- OIDC 登录（config.yaml auth.* 段默认开启，配齐 issuer/client_id 即启用）----
# Keycloak 等管理台里 client（confidential）的 Credentials → Client secret。
# 缺失时 auth 降级关闭（日志 auth disabled: ...）。
OIDC_CLIENT_SECRET=

# token/state 的 HMAC 签名密钥。生成：openssl rand -hex 32
# 未设置时进程内随机生成临时密钥——功能可用，但每次重启全员掉登录；生产必填。
OMB_AUTH_SECRET=
