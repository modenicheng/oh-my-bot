{
  "name": "oh-my-bot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm --filter client build",
    "dev": "concurrently -n omb,web -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "cd server && cross-env OMB_CONFIG_DIR=.. OMB_MANUAL_DIR=../docs/manual air",
    "typecheck": "pnpm --filter @omb/bot-api --filter @omb/protocol --filter client typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "vitest": "^5.0.3"
  }
}
