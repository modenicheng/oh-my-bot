node_modules/
dist/
*.tsbuildinfo
/.artifacts/
# protocol 生成物（由 schema 源再生成）
packages/protocol/gen/
# 运行时产物
server/omb
server/omb.exe
/data/
*.log
omb.exe*

# agent skills (repo-local, installed via npx skills)
/.agents/
/.claude/
/.pi/
/skills/
data/

# build artifacts (copied at build time, same as web/)；.gitkeep 保证
# embed 目录在 fresh clone 下可编译（all: 前缀会嵌入 dotfile）
server/cmd/omb/manual/*
!server/cmd/omb/manual/.gitkeep
server/cmd/omb/web/*
!server/cmd/omb/web/.gitkeep
server/tmp/

# Local server configuration and secrets (copy from the tracked examples).
/config.yaml
/.env
/server/config.yaml
/server/.env

# 本地运行时文件：dev server 进程号、AI/会话工具的临时产物
*.pid
/.v2c/
/.zcode/
